# Unité systemd de barking-node.
#
# Installation (exemple) :
#   useradd --system --home-dir /var/lib/barking-node --shell /usr/sbin/nologin barking-node
#   install -m 0755 barking-node /usr/local/bin/barking-node
#   install -d -m 0700 -o barking-node -g barking-node /var/lib/barking-node
#   install -m 0644 barking-node.toml /etc/barking-node.toml
#   sudo -u barking-node barking-node init --data-dir /var/lib/barking-node
#   install -m 0644 barking-node.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now barking-node
[Unit]
Description=Nœud Barking (paquets chiffrés en attente, QUIC)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=barking-node
Group=barking-node
ExecStart=/usr/local/bin/barking-node run --config /etc/barking-node.toml
Restart=on-failure
RestartSec=5
# Le dossier de données (clé, base) est le seul endroit inscriptible.
StateDirectory=barking-node
StateDirectoryMode=0700
ReadWritePaths=/var/lib/barking-node
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# AF_UNIX : le pilote de signaux de tokio crée une paire de sockets Unix au
# démarrage (tokio signal/unix.rs, `UnixStream::pair().expect(..)`).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
# À tester sur une vraie machine avant de l'activer (un appel système manquant
# tue le processus) :
# SystemCallFilter=@system-service
# Petit appareil (Raspberry Pi) : plafond de mémoire du service.
# MemoryMax=512M
UMask=0077
# Port UDP > 1024 : aucune capacité n'est nécessaire.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
