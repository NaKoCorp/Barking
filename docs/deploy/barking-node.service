# systemd unit for barking-node.
#
# Installation (example):
#   useradd --system --home-dir /var/lib/barking-node --shell /usr/sbin/nologin barking-node
#   install -m 0755 barking-node /usr/local/bin/barking-node
#   install -d -m 0700 -o barking-node -g barking-node /var/lib/barking-node
#   install -m 0644 barking-node.toml /etc/barking-node.toml
#   sudo -u barking-node barking-node init --data-dir /var/lib/barking-node
#   install -m 0644 barking-node.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now barking-node
#
# First deployment on a host (before announcing the node):
#   systemd-analyze verify /etc/systemd/system/barking-node.service
#     -> no output (no unknown directive, ExecStart found).
#   systemd-analyze security barking-node.service
#     -> overall exposure well below 5.0 (MEDIUM); review any directive
#        reported as weaker than in this file.
#   systemctl start barking-node && journalctl -u barking-node -n 20
#     -> "node <identifier> started", then the periodic counters; no restart loop.
#   stat -c '%a %U' /var/lib/barking-node /var/lib/barking-node/node.key /var/lib/barking-node/node.db
#     -> 700, 600 and 600, all owned by barking-node.
[Unit]
Description=Barking node (pending encrypted packets, QUIC)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=barking-node
Group=barking-node
ExecStart=/usr/local/bin/barking-node run --config /etc/barking-node.toml
Restart=on-failure
RestartSec=5
# The data directory (key, database) is the only writable place.
StateDirectory=barking-node
StateDirectoryMode=0700
ReadWritePaths=/var/lib/barking-node
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# AF_UNIX: tokio's signal driver creates a pair of Unix sockets at
# startup (tokio signal/unix.rs, `UnixStream::pair().expect(..)`).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
# Test on a real machine before enabling it (a missing system call
# kills the process):
# SystemCallFilter=@system-service
# Small device (Raspberry Pi): memory cap for the service.
# MemoryMax=512M
UMask=0077
# UDP port > 1024: no capability is needed.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
