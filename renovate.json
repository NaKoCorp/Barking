{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Merge patch, minor and digest updates once the required checks pass.",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "A minor bump of a 0.x crate is a breaking change under Cargo semver: leave it for review.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^[~^=]?0\\./",
      "automerge": false
    }
  ]
}
