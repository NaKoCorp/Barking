<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld of 8 devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld appareil sur 8</string>
			<key>other</key>
			<string>%lld appareils sur 8</string>
		</dict>
	</dict>
	<key>%lld packets pending</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld paquet en attente</string>
			<key>other</key>
			<string>%lld paquets en attente</string>
		</dict>
	</dict>
	<key>%lld unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld non lu</string>
			<key>other</key>
			<string>%lld non lus</string>
		</dict>
	</dict>
	<key>Internet · %lld relays</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Internet · %lld relais</string>
			<key>other</key>
			<string>Internet · %lld relais</string>
		</dict>
	</dict>
	<key>Still unreachable · %lld packets wait</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Toujours injoignable · %lld paquet attend</string>
			<key>other</key>
			<string>Toujours injoignable · %lld paquets attendent</string>
		</dict>
	</dict>
	<key>Sent %lld packets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld paquet envoyé</string>
			<key>other</key>
			<string>%lld paquets envoyés</string>
		</dict>
	</dict>
	<key>%lld messages received</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld message reçu</string>
			<key>other</key>
			<string>%lld messages reçus</string>
		</dict>
	</dict>
	<key>Found %lld words; 24 are needed. The clipboard was cleared.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld mot trouvé ; il en faut 24. Le presse-papiers a été vidé.</string>
			<key>other</key>
			<string>%lld mots trouvés ; il en faut 24. Le presse-papiers a été vidé.</string>
		</dict>
	</dict>
	<key>%lld words left to fill in.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Encore %lld mot à saisir.</string>
			<key>other</key>
			<string>Encore %lld mots à saisir.</string>
		</dict>
	</dict>
	<key>Found %lld words; 24 are needed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld mot trouvé ; il en faut 24.</string>
			<key>other</key>
			<string>%lld mots trouvés ; il en faut 24.</string>
		</dict>
	</dict>
	<key>%lld had already left: %@ will still receive it.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld était déjà parti : %@ le recevra quand même.</string>
			<key>other</key>
			<string>%lld étaient déjà partis : %@ le recevra quand même.</string>
		</dict>
	</dict>
	<key>%@, %@ and %lld others</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$@ et %3$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld autre personne</string>
			<key>other</key>
			<string>%lld autres personnes</string>
		</dict>
	</dict>
</dict>
</plist>
